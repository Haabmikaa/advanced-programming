<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <display-name>Distributed Quiz Web Application</display-name>
    
    <!-- Welcome file -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>pages/home.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- Session timeout -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    
    <!-- Servlet Definitions -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.quizapp.servlets.LoginServlet</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.quizapp.servlets.LogoutServlet</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>QuizServlet</servlet-name>
        <servlet-class>com.quizapp.servlets.QuizServlet</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>ResultServlet</servlet-name>
        <servlet-class>com.quizapp.servlets.ResultServlet</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.quizapp.servlets.AdminServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminUserServlet</servlet-name>
        <servlet-class>com.quizapp.servlets.AdminUserServlet</servlet-class>
    </servlet>

    <!-- Servlet Mappings -->
    <servlet-mapping>
        <servlet-name>AdminUserServlet</servlet-name>
        <url-pattern>/manageUser</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>QuizServlet</servlet-name>
        <url-pattern>/quiz</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>ResultServlet</servlet-name>
        <url-pattern>/result</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>
    
    <!-- Error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/pages/error/404.jsp</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/pages/error/500.jsp</location>
    </error-page>
    
</web-app>